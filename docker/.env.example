# ClassRadar Environment Configuration Template
# Copy this file to .env before starting containers

# Database Configuration (PostgreSQL)
POSTGRES_USER=classradar
POSTGRES_PASSWORD=classradar_secret
POSTGRES_DB=classradar_db
DATABASE_URL=postgresql://classradar:classradar_secret@postgres:5432/classradar_db?schema=public

# In-Memory Cache & Broadcast (Redis)
REDIS_URL=redis://redis:6379

# Authentication & Security
JWT_SECRET=super_secret_jwt_classradar_production_key_2026

# Networking & Ports
BACKEND_PORT=3000
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
