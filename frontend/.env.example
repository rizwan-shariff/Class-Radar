# Backend API & WebSocket URLs (e.g. deployed on Render)
NEXT_PUBLIC_API_URL="https://your-classradar-api.onrender.com/api/v1"
NEXT_PUBLIC_SOCKET_URL="https://your-classradar-api.onrender.com"

# NVIDIA NIM AI Voice Chatbot Configuration
# Set this in Vercel / Render environment variables
NVIDIA_API_KEY="nvapi-your-key-here"
NEXT_PUBLIC_NVIDIA_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"

